{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "build:shared-deps": "node --experimental-transform-types scripts/build-shared-deps.ts",
    "dev": "electron-vite dev",
    "rebuild:native": "electron-rebuild -f -w node-pty && node scripts/fix-node-pty-perms.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e": "pnpm build && pnpm build:shared-deps && pnpm test:e2e",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "verify:notices": "node --experimental-transform-types scripts/verify-dependency-notices.ts"
  },
  "dependencies": {
    "@arsumbris/au-component-catalog": "workspace:*",
    "@arsumbris/au-engine-sdk": "link:../../au-engine-sdk",
    "@arsumbris/au-host-app": "workspace:*",
    "@arsumbris/au-host-launcher": "workspace:*",
    "@arsumbris/au-host-sdk": "workspace:*",
    "@arsumbris/au-mcp-sdk": "link:../../au-mcp-sdk",
    "@arsumbris/component-contract": "workspace:*",
    "@arsumbris/container-core": "workspace:*",
    "@arsumbris/container-kit": "workspace:*",
    "@arsumbris/intent": "workspace:*",
    "@arsumbris/preview-content": "workspace:*",
    "@arsumbris/range": "workspace:*",
    "@arsumbris/selection": "workspace:*",
    "@arsumbris/style": "link:../packages/style",
    "@arsumbris/type-query": "workspace:*",
    "@arsumbris/typed-value": "workspace:*",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.185.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.1",
    "rollup": "^4.62.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
