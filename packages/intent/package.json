{
  "name": "@arsumbris/intent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "node --experimental-transform-types ../../../au-type-codegen/src/cli.ts --entry ../../dogfood --repo intent --module selection=@arsumbris/selection --module au-host-sdk=@arsumbris/au-host-sdk/generated --meta intent-routing-meta=const:ROUTING --meta-satisfies --out src/generated.ts"
  },
  "dependencies": {
    "@arsumbris/selection": "link:../selection",
    "@arsumbris/range": "link:../range",
    "@arsumbris/au-host-sdk": "link:../au-host-sdk"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
